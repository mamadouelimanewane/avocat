# Configuration LexPremium - V2.0 (Janvier 2026)
# Copiez ce fichier et renommez-le en .env.local

# === BASE DE DONNÉES ===
# MongoDB Atlas requis pour le déploiement Cloud
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/lexpremium?retryWrites=true&w=majority"

# === INTELLIGENCE ARTIFICIELLE ===
# DeepSeek (Recommandé - Économies > 80%)
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"

# OpenAI (Fallback automatique)
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"

# === RELANCES & COMMUNICATION ===
# Requis pour les relances WhatsApp Business
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_WHATSAPP_NUMBER="whatsapp:+221xxxxxxxxx"

# === PAIEMENT MOBILE MONEY (MODULE V2.0) ===
# Orange Money API (Senegal)
ORANGE_MONEY_API_KEY="your_orange_money_api_key"
ORANGE_MONEY_MERCHANT_ID="your_merchant_id"

# Wave API (Senegal/Africa)
WAVE_API_KEY="your_wave_api_key"

# === EMAIL & STORAGE ===
# Resend (Email transactionnel)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Vercel Blob (Stockage documents)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# === CONFIGURATION DOMAINE ===
# URL de base de l'application (pour les liens dans les emails)
NEXT_PUBLIC_APP_URL="https://lexapp.vercel.app"

# Sans ces clés, l'IA fonctionne en mode "RAG local" (recherche simple)
