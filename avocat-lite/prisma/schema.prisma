// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  role      String   @default("AVOCAT") // AVOCAT, ASSISTANT
  password  String
  active    Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  dossiers  Dossier[]
}

model Client {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String?
  phone     String?
  accessCode String?
  address   String?
  
  dossiers  Dossier[]
  factures  Facture[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dossier {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  reference   String   @unique
  status      String   @default("EN_COURS") // EN_COURS, CLOS, ARCHIVE
  description String?
  
  clientId    String   @db.ObjectId
  client      Client   @relation(fields: [clientId], references: [id])
  
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  
  events      Event[]
  documents   Document[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      String   @default("AUTRE")
  status    String   @default("DRAFT")
  path      String?
  
  dossierId String   @db.ObjectId
  dossier   Dossier  @relation(fields: [dossierId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  date        DateTime
  type        String   @default("AUDIENCE") // AUDIENCE, RENDEZ_VOUS, DELAI
  description String?
  
  dossierId   String   @db.ObjectId
  dossier     Dossier  @relation(fields: [dossierId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Facture {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  number      String   @unique
  date        DateTime @default(now())
  amount      Float
  status      String   @default("BROUILLON") // BROUILLON, ENVOYE, PAYE
  
  clientId    String   @db.ObjectId
  client      Client   @relation(fields: [clientId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Jurisprudence {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String
  category  String?
  region    String   @default("SENEGAL")
  
  createdAt DateTime @default(now())
}
